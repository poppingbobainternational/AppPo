<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    /* Variables */
    :root {
      --primary-color: #343a40;
      --secondary-color: #f8f9fa;
      --green-color: #07d437;
      --yellow-color: #f7c00d;
      --orange-color: #d8913f;
      --red-color: #e61628;
      --shadow-color: rgba(0, 0, 0, 0.1);
    }

    /* Estilos generales */
    body {
      margin: 0;
      padding: 0;
      overflow-x: hidden; /* Evitar scroll horizontal */
      background-color: #f1f1f1;
    }

    /* Usamos container-fluid sin padding extra */
    .container-custom {
      max-width: 100%;
      padding: 10px 0; /* Solo 10px arriba y abajo, 0 en laterales */
    }

    h1 {
      font-size: 2.5rem;
      font-weight: bold;
      margin-bottom: 30px;
      text-align: center;
      color: var(--primary-color);
    }

    .brand-title {
      margin: 20px 0;
      font-size: 1.5rem;
      color: var(--primary-color);
      text-align: center;
      padding: 10px;
      border-radius: 5px;
      background-color: rgba(52, 58, 64, 0.1);
    }

    /* Contenedor sin scroll horizontal global */
    .scroll-wrapper {
      /* No se define overflow-x aquí para evitar scroll extra */
    }

    .table-container {
      width: 100%;
      margin-bottom: 40px;
      padding: 15px;
      border-radius: 10px;
      box-shadow: 0 4px 10px var(--shadow-color);
      background-color: #fff;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      border-radius: 10px;
      overflow: hidden;
    }

    th, td {
      padding: 12px;
      border: 1px solid #dee2e6;
      text-align: center;
      vertical-align: middle;
      font-size: 1rem;
      transition: background-color 0.3s ease;
    }

    th {
      background-color: var(--primary-color);
      color: #fff;
      font-weight: bold;
    }

    .presentation-header {
      background-color: var(--secondary-color);
      font-weight: bold;
    }

    /* Colores condicionales para las celdas */
    .cell-red {
      background-color: var(--red-color) !important;
      color: #721c24;
      font-weight: bold;
    }

    .cell-orange {
      background-color: var(--orange-color) !important;
      color: #856404;
      font-weight: bold;
    }

    .cell-yellow {
      background-color: var(--yellow-color) !important;
      color: #856404;
      font-weight: bold;
    }

    .cell-green {
      background-color: var(--green-color) !important;
      color: #155724;
      font-weight: bold;
    }

    /* Animaciones */
    td:hover {
      background-color: rgba(52, 58, 64, 0.1);
      cursor: pointer;
    }

    /* Media queries para dispositivos móviles */
    @media (max-width: 768px) {
      th, td {
        padding: 8px;
        font-size: 0.9rem;
      }
      .brand-title {
        font-size: 1.2rem;
      }
    }

    @media (max-width: 576px) {
      th, td {
        padding: 6px;
        font-size: 0.8rem;
      }
      h1 {
        font-size: 1.8rem;
      }
      .brand-title {
        font-size: 1rem;
      }
    }
  </style>
</head>
<script>
    // Recargar la página automáticamente cada 2 minutos (120000 ms)
    setTimeout(() => {
        location.reload();
    }, 120000);
</script>
<body>
  <div class="container-fluid container-custom">
    <!-- Título principal -->


    <!-- Contenedor general -->
    <div class="scroll-wrapper">
      <% if (Object.keys(organizedTables).length > 0) { %>
        <% for (const [brand, tables] of Object.entries(organizedTables)) { %>
          <!-- Título de la marca -->
          <div class="brand-title"><%= brand %></div>

          <!-- Contenedor de la tabla con wrapper responsivo -->
          <div class="table-container">
            <div class="table-responsive">
              <table class="table table-striped table-bordered">
                <thead>
                  <tr>
                    <th>Presentación</th>
                    <% 
                      // Recopilar todos los sabores únicos para la marca
                      const allFlavors = new Set();
                      Object.values(tables).forEach(flavors => {
                        Object.keys(flavors).forEach(flavor => allFlavors.add(flavor));
                      });
                      const flavorsArray = Array.from(allFlavors).sort(); // Ordenar alfabéticamente
                    %>
                    <% flavorsArray.forEach(flavor => { %>
                      <th><%= flavor %></th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% for (const [presentation, flavors] of Object.entries(tables)) { %>
                    <tr>
                      <td class="presentation-header"><%= presentation %></td>
                      <% flavorsArray.forEach(flavor => { 
                        const quantity = flavors[flavor] || 0;
                        const qty = Number(quantity);
                      %>
                        <td class="<%= 
                          qty < 1 ? 'cell-red' : 
                          qty < 5 ? 'cell-orange' : 
                          qty < 10 ? 'cell-yellow' : 
                          'cell-green' 
                        %>">
                          <%= quantity %>
                        </td>
                      <% }) %>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <p class="text-center">No hay productos disponibles en el inventario.</p>
      <% } %>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
